<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="3" author="grocery">
        <createTable tableName="grocery_store_prices">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="grocery_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="store_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="DECIMAL(12, 2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="grocery_store_prices"
                baseColumnNames="grocery_id"
                constraintName="fk_grocery_store_prices_grocery"
                referencedTableName="groceries"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="grocery_store_prices"
                baseColumnNames="store_id"
                constraintName="fk_grocery_store_prices_store"
                referencedTableName="stores"
                referencedColumnNames="id"/>
        <addUniqueConstraint
                tableName="grocery_store_prices"
                columnNames="grocery_id, store_id"
                constraintName="uk_grocery_store_prices_grocery_store"/>
    </changeSet>
</databaseChangeLog>
